pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
        parallelsAlwaysFailFast();
    }

    environment {
        NVM_SILENT = 'true'
        NODE_VERSION = '23.6.1'
        NVM_DIR = '/var/jenkins_home/.nvm'
        SECRETS_DIR = '/var/jenkins_home/secrets'
        PR_BUILDS_DIR = '/var/jenkins_home/www/builds'
        SHARED_DATA_DIR = '/var/jenkins_home/shared'
        CHAIN_DATA_DIR = "${WORKSPACE}/output/_prebuild_chain_data"
        PINATA_DATA_DIR = "${WORKSPACE}/output/_prebuild_pinata_data"
        COMMIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
        BRANCH_NAME = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
        IS_PRODUCTION = "${env.BRANCH_NAME == 'production' ? 'true' : 'false'}"
    }

    stages {
        stage('Submodules') {
            steps {
                // Initialize and update submodules
                sh '''
                    git submodule init
                    git submodule update --recursive --remote
                '''
            }
        }

        stage('Setup Environment') {
            steps { // TODO: Dehydrate instead of hardcoding 40.1
                sh '''#!/bin/bash
                    # Install NVM if not present
                    if [ ! -d "$NVM_DIR" ]; then
                        curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
                        chmod -R 755 "$NVM_DIR"  # Add execute permissions
                    fi

                    # Ensure NVM script is executable
                    chmod +x "$NVM_DIR/nvm.sh"

                    # Source NVM and activate Node version
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent

                    # Ensure pinned pnpm@9.15.9 is present. Skip reinstall when
                    # already at the right version — reinstalling on every job
                    # creates a race window where npm's atomic rename swap can
                    # leave a .pnpm-XXXXXX temp dir sitting in global node_modules,
                    # and the next install then fails with ENOTEMPTY on the rename.
                    # Nuke any such leftovers before attempting a fresh install so
                    # we self-heal from a prior aborted run.
                    if [ "$(pnpm --version 2>/dev/null)" != "9.15.9" ]; then
                        find "$(npm root -g)" -maxdepth 1 -name '.pnpm-*' -exec rm -rf {} + 2>/dev/null || true
                        npm install -g pnpm@9.15.9
                    fi

                    # Copy .env file from secrets
                    cp ${SECRETS_DIR}/0/.env .env
                    chmod 600 .env
                '''
            }
        }


        stage('Install Dependencies') {
            steps {
                // Always run pnpm install. The previous "skip if
                // pnpm-lock.yaml isn't newer than node_modules" guard
                // silently stranded the build with a stale tree whenever
                // node_modules's mtime drifted (the directory mtime updates
                // when files are written inside, which can race the
                // lockfile mtime check). We hit this when @wagmi/core was
                // added: the build kept reporting "changed 1 package in
                // 725ms" while the rest of the tree stayed pinned to a
                // pre-wagmi snapshot, and fetch_video_metadata.js died on
                // ERR_MODULE_NOT_FOUND for @wagmi/core.
                //
                // pnpm install against an already-satisfied lockfile is
                // fast — hardlinks from the content-addressable store —
                // so the optimisation wasn't worth the failure mode.
                sh '''#!/bin/bash
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent
                    pnpm install --no-frozen-lockfile --config.ignore-scripts=false
                '''
            }
        }

        stage('Create Chain Data Directory') {
            steps {
                sh '''#!/bin/bash
                    mkdir -p ${CHAIN_DATA_DIR}
                '''
            }
        }

        stage('Copy Chain Data') {
            steps {
                sh '''#!/bin/bash
                    if [ ! -f "${SHARED_DATA_DIR}/chain_data/.last_fetch_success" ]; then
                        echo "Chain data not found or outdated. Please ensure chain-data-fetcher job is running."
                        exit 1
                    fi

                    # Create chain data dir
                    mkdir -p ${CHAIN_DATA_DIR}

                    # Copy shared data to workspace
                    cp -r ${SHARED_DATA_DIR}/chain_data/* ${CHAIN_DATA_DIR}
                    cp ${CHAIN_DATA_DIR}/time_data.json src/data/time_data.json
                '''
            }
        }

        stage('Copy Pinata Data') {
            steps {
                sh '''#!/bin/bash
                    if [ -f "${SHARED_DATA_DIR}/pinata_data/.last_fetch_success" ]; then
                        mkdir -p ${PINATA_DATA_DIR}
                        cp -r ${SHARED_DATA_DIR}/pinata_data/* ${PINATA_DATA_DIR}
                        echo "Pinata data copied from shared location"
                    else
                        echo "Warning: Pinata data not found. IPFS status page may be stale."
                    fi
                '''
            }
        }

        stage('Fetch Blue Railroad Metadata') {
            steps {
                sh '''#!/bin/bash
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent
                    npm run fetch-video-metadata
                '''
            }
        }

        stage('Download Blue Railroad Videos') {
            steps {
                sh '''#!/bin/bash
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent
                    npm run download-videos
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''#!/bin/bash
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent
                    npm test
                    '''
            }
        }

        stage("Build all sites in parallel") {
            parallel {
                stage('Build cryptograss.live') {
                    steps {
                        script {
                            def branchName = getBranchName()
                            def isPreviewBuild = !branchName.equals('origin/production')

                            withEnv([
                                "PREVIEW_BUILD=${isPreviewBuild}",
                                "COMMIT_SHA=${COMMIT_SHA}"
                            ]) {
                                sh '''#!/bin/bash
                                    export SITE=cryptograss.live
                                    . "$NVM_DIR/nvm.sh" --silent
                                    nvm use ${NODE_VERSION} --silent
                                    npm run build
                                '''
                            }
                       }
                    }
                }

                stage('Build justinholmes.com') {
                    steps {
                        script {
                            def branchName = getBranchName()
                            def isPreviewBuild = !branchName.equals('origin/production')

                            withEnv([
                                "PREVIEW_BUILD=${isPreviewBuild}",
                                "COMMIT_SHA=${COMMIT_SHA}"
                            ]) {
                                sh '''#!/bin/bash
                                    export SITE=justinholmes.com
                                    . "$NVM_DIR/nvm.sh" --silent
                                    nvm use ${NODE_VERSION} --silent
                                    npm run build
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def branchName = getBranchName()

                    if (!branchName.equals('origin/production')) {
                        echo "Preview build for ${COMMIT_SHA} (${branchName})"

                        // Preview build for any non-production branch
                        sh "mkdir -p ${PR_BUILDS_DIR}/${COMMIT_SHA}"

                        withEnv([
                            "PREVIEW_BUILD=true",
                            "COMMIT_SHA=${COMMIT_SHA}",
                            "BRANCH_NAME=${branchName}"
                        ]) {
                            sh """
                                export NVM_DIR="\$HOME/.nvm"
                                [ -s "\$NVM_DIR/nvm.sh" ] && . "\$NVM_DIR/nvm.sh"
                                nvm use ${NODE_VERSION}

                                NODE_PATH=\$(npm root -g)
                                export NODE_PATH

                                node deployment/scripts/modify_build_htmls.js

                                rsync -av --delete output/dist/* ${PR_BUILDS_DIR}/${COMMIT_SHA}
                            """
                        }

                        // Comment on the commit instead of the PR
                        withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                            def previewUrls = """🔍 [Preview URLs](https://maybelle.cryptograss.live:8081/build-previews/${COMMIT_SHA}) for ${env.COMMIT_SHA} (${env.BRANCH_NAME})"""
                            sh """
                                curl -X POST \
                                -H "Authorization: token ${GITHUB_TOKEN}" \
                                -H "Accept: application/vnd.github.v3+json" \
                                https://api.github.com/repos/cryptograss/justinholmes.com/commits/${COMMIT_SHA}/comments \
                                -d '{"body": "${previewUrls}"}'
                            """
                        }

                    } else {
                        // Production build - copy to staging area and create deploy marker
                        // Actual deployment to NFS is handled by root cron on maybelle host
                        // This separation prevents Jenkins compromise from directly pushing to production

                        echo "Production build for ${COMMIT_SHA}"
                        sh "mkdir -p ${PR_BUILDS_DIR}/production"
                        sh """
                            rsync -av --delete output/dist/* ${PR_BUILDS_DIR}/production
                        """

                        // Create deploy marker for root cron to pick up
                        echo "Creating deploy marker for production..."
                        sh """
                            echo "commit=${COMMIT_SHA} build=${BUILD_NUMBER} time=\$(date -Iseconds)" > ${PR_BUILDS_DIR}/production/.deploy-ready
                        """
                        echo "Production build staged - deploy marker created"
                    }
                }
            }
        }

    }
    post {
        success {
                archiveArtifacts artifacts: 'output/**/*'
        }
    }

}

def getBranchName() {
    def branchName = ''
    if (env.CHANGE_BRANCH) {
        // Pull Request
        branchName = env.CHANGE_BRANCH
    } else if (env.GIT_BRANCH) {
        // Direct branch build
        branchName = env.GIT_BRANCH
    } else {
        // Fallback to shell command
        branchName = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
    }
    return branchName
}