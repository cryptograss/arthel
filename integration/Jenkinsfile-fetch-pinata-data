pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 5, unit: 'MINUTES')
    }

    environment {
        NODE_VERSION = '23.6.1'
        NVM_DIR = '/var/jenkins_home/.nvm'
        SECRETS_DIR = '/var/jenkins_home/secrets'
        SHARED_DATA_DIR = '/var/jenkins_home/shared'
        PINATA_DATA_DIR = "${SHARED_DATA_DIR}/pinata_data"
    }

    stages {
        stage('Setup') {
            steps {
                sh '''
                    mkdir -p ${PINATA_DATA_DIR}

                    # Copy .env file from secrets (contains PINATA_JWT)
                    cp ${SECRETS_DIR}/0/.env .env
                    chmod 600 .env

                    # Source NVM and activate Node version
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent

                    # Ensure pinned pnpm@9.15.9 is present. Skip reinstall when
                    # already at the right version — reinstalling on every job
                    # creates a race window where npm's atomic rename swap can
                    # leave a .pnpm-XXXXXX temp dir sitting in global node_modules,
                    # and the next install then fails with ENOTEMPTY on the rename.
                    # Nuke any such leftovers before attempting a fresh install so
                    # we self-heal from a prior aborted run.
                    if [ "$(pnpm --version 2>/dev/null)" != "9.15.9" ]; then
                        find "$(npm root -g)" -maxdepth 1 -name '.pnpm-*' -exec rm -rf {} + 2>/dev/null || true
                        npm install -g pnpm@9.15.9
                    fi

                    pnpm install --no-frozen-lockfile --config.ignore-scripts=false
                '''
            }
        }

        stage('Fetch Pinata Pins') {
            steps {
                sh '''
                    # Source NVM and activate Node version
                    . "$NVM_DIR/nvm.sh" --silent
                    nvm use ${NODE_VERSION} --silent
                    npm run fetch:pinata

                    # Copy the data to shared location
                    cp -r output/_prebuild_pinata_data/* ${PINATA_DATA_DIR}/
                '''
            }
        }
    }

    post {
        success {
            // Touch a file to indicate successful completion
            sh "touch ${PINATA_DATA_DIR}/.last_fetch_success"
            echo "Pinata pins data refreshed successfully"
        }
        failure {
            echo "Pinata fetch failed - check logs above"
        }
    }
}
