<header class="jh-top">
    {% if not no_nav and build.block_display %}
    <div class="jh-hud">
        <span><b>block</b> {{ build.block_display }}</span>
        <span><a href="{{ basePath }}/shows">{{ build.shows }} shows</a></span>
        <span><a href="{{ basePath }}/songs/all-songs">{{ build.songs }} songs</a></span>
        <span><a href="{{ basePath }}/ensemble">{{ build.pickers }} pickers</a></span>
    </div>
    {% endif %}

    <div class="jh-marquee">
        <a href="{{ basePath }}/" id="home-link-at-top">
            {% if use_white_logo %}
                <img id="main-logo-at-top" width="1511" height="330" alt="Justin Holmes"
                     src="{{ get_image("name-with-logo-white.png") }}">
            {% else %}
                <img id="main-logo-at-top" width="1511" height="330" alt="Justin Holmes"
                     src="{{ get_image("name-with-log.png") }}">
            {% endif %}
        </a>
        <a class="curly" id="immutable-string-band" href="{{ basePath }}/ensemble">and the immutable string band</a>

        {% if no_slogan %}
            <!-- no slogan -->
        {% else %}
            <div class="jh-slogan-line"><p class="pixel-font" id="slogan">{{ custom_slogan if custom_slogan else "future-proofing old-timey music" }}</p></div>
        {% endif %}
    </div>

    {% if no_nav %}
        <!-- no nav -->
    {% else %}
        {% include 'partials/nav.njk' %}
    {% endif %}
</header>
