{% extends 'shared/layouts/base.njk' %}
{% block main %}
{% include 'partials/bigger-banner.njk' %}

<div class="jh-wrap">

    {# ---- Now playing: the newest record, and the tracks Rabbithole hands out from it ---- #}
    {% set fourmasks = get_record_metadata("4masks") %}
    {% set ready = eco.tracks_by_record["4masks"] %}
    <section class="px-box" aria-labelledby="now-playing">
        <h2 class="px-title" id="now-playing">Now playing</h2>
        <div class="jh-now">
            <a href="{{ eco.pickipedia }}/wiki/4masks">
                <img class="jh-sleeve pixelated" width="400" height="400"
                     src="{{ get_image("albums/four-masks-temp.png") }}"
                     alt="The 4masks sleeve: four squares, red, blue, green and yellow">
            </a>
            <div>
                <h3 class="jh-record-name">4masks</h3>
                <p class="px-sub">Our second record. Cut at Tunesmith Studios, Nashville.</p>

                {% if ready and ready.length %}
                <p class="mt-3 mb-0">Hear it in <a href="{{ eco.pickipedia }}/wiki/Rabbithole">Rabbithole</a>,
                    the player that shows the whole band as the track plays: who's in, who has the solo,
                    and where each picker went next.</p>
                <ul class="jh-tracks">
                    {% for track in ready %}
                    <li><a href="{{ track.listen }}"><i class="px-play"></i>{{ track.title }} <small>play in Rabbithole</small></a></li>
                    {% endfor %}
                </ul>
                <p class="px-note mt-2">A track joins this list when its chart is finished.
                    The whole record is <a href="{{ eco.pickipedia }}/wiki/4masks">on PickiPedia</a>.</p>
                {% else %}
                <p class="mt-3 mb-0">The whole record, who's on each track, and where to hear it:
                    <a href="{{ eco.pickipedia }}/wiki/4masks">4masks on PickiPedia</a>.</p>
                {% endif %}

                <div class="px-btns">
                    {% if ready and ready.length %}
                    <a class="px-btn px-btn--go" href="{{ ready[0].listen }}"><i class="px-play"></i>Press start</a>
                    {% endif %}
                    <a class="px-btn" href="{{ basePath }}/listen">Everything to hear</a>
                    {% if fourmasks.bandcamp_url %}
                    <a class="px-btn px-btn--quiet" href="{{ fourmasks.bandcamp_url }}">Bandcamp</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    {# ---- Shows: what's ahead if anything is, and the last few ---- #}
    {% set ahead = [] %}
    {% set behind = [] %}
    {% for show_id, show in shows %}
        {% if show.is_future %}
            {% set soonestFirst = ahead.unshift(show) %}
        {% elif behind.length < 4 %}
            {% set latestFirst = behind.push(show) %}
        {% endif %}
    {% endfor %}

    {% if ahead.length %}
    <section class="px-box" aria-labelledby="next-up">
        <h2 class="px-title" id="next-up">Next up</h2>
        <ol class="jh-showlist">
            {% for show in ahead %}
            <li>
                <span class="jh-show-when">{{ show.local_date }}</span>
                <span class="jh-show-what">
                    <a href="{{ basePath }}{{ show.resource_url }}">{{ show.title }}</a>
                    <span class="jh-show-where">{{ show.venue }}{% if show.locality %}, {{ show.locality }}{% endif %}{% if show.region1 %}, {{ show.region1 }}{% endif %}</span>
                </span>
                <span class="jh-show-block">block {{ show.blockheight.toLocaleString("en-US") }}</span>
            </li>
            {% endfor %}
        </ol>
    </section>
    {% endif %}

    <section class="px-box" aria-labelledby="latest-shows">
        <h2 class="px-title" id="latest-shows">Latest instances</h2>
        <p class="px-sub mb-2">&ldquo;Every time I take the stage and every time I put on cans in the studio, I seek to make a new instance of the class Band.&rdquo; Each one is kept: its setlist, and who played.</p>
        <ol class="jh-showlist">
            {% for show in behind %}
            <li>
                <span class="jh-show-when">{{ show.local_date }}</span>
                <span class="jh-show-what">
                    <a href="{{ basePath }}{{ show.resource_url }}">{{ show.title }}</a>
                    <span class="jh-show-where">{{ show.venue }}{% if show.locality %}, {{ show.locality }}{% endif %}{% if show.region1 %}, {{ show.region1 }}{% endif %}</span>
                    {% include 'partials/show-strip.njk' %}
                </span>
                <span class="jh-show-block">block {{ show.blockheight.toLocaleString("en-US") }}</span>
            </li>
            {% endfor %}
        </ol>
        <div class="px-btns">
            <a class="px-btn" href="{{ basePath }}/shows">All {{ build.shows }} shows</a>
            {% if not ahead.length %}
            <a class="px-btn px-btn--quiet" href="{{ basePath }}/contact">Book one</a>
            {% endif %}
        </div>
    </section>

    {# ---- The doors out: where the music goes when it leaves this site ---- #}
    <div class="jh-doors">
        <section class="px-box" aria-labelledby="door-rabbithole">
            <h2 class="px-title" id="door-rabbithole">Rabbithole</h2>
            <div class="jh-door-art">
                <img class="pixelated" src="{{ get_image("rabbit.png") }}" alt="" width="200" height="200">
            </div>
            <p>Discovery through connections instead of algorithms. Hear a picker you like, follow
                them to the next thing they played on, and keep going.</p>
            <div class="px-btns">
                <a class="px-btn px-btn--go" href="{{ eco.rabbithole }}"><i class="px-play"></i>Go down it</a>
            </div>
        </section>

        <section class="px-box" aria-labelledby="door-oracle">
            <h2 class="px-title px-title--long" id="door-oracle">The Oracle of Bluegrass Bacon</h2>
            <div class="jh-door-art">
                <div class="jh-bacon" aria-hidden="true"><i></i><b></b><i></i><b></b><i></i><b></b><i></i></div>
            </div>
            <p>Any two pickers, and all the music between them: the records, the shows, and the
                folks who played with both.{% if eco.graph and eco.graph.pickers %}
                {{ eco.graph.pickers.toLocaleString("en-US") }} pickers so far.{% endif %}</p>
            <div class="px-btns">
                <a class="px-btn" href="{{ eco.justin.bacon }}">Start from Justin</a>
                <a class="px-btn px-btn--quiet" href="{{ eco.justin.challenge }}">Find him in six</a>
            </div>
        </section>

        <section class="px-box" aria-labelledby="door-pickipedia">
            <h2 class="px-title" id="door-pickipedia">PickiPedia</h2>
            <div class="jh-door-art">
                <div class="jh-wikipage" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            </div>
            <p>The wiki where all of this is written down, by the people who were there: the songs,
                the sessions, the pickers, the shows.</p>
            <div class="px-btns">
                <a class="px-btn" href="{{ eco.justin.wiki }}">Justin's page</a>
                <a class="px-btn px-btn--quiet" href="{{ eco.pickipedia }}">The front page</a>
            </div>
        </section>
    </div>

    {# ---- The band: whoever has been on the most instances ---- #}
    <section class="px-box" aria-labelledby="the-band">
        <h2 class="px-title" id="the-band">The Immutable String Band</h2>
        <p class="px-sub mb-3">A touring, rotating band: {{ build.pickers }} pickers so far. These have been on the most instances.</p>
        <ul class="jh-party">
            {% for name, picker in pickers_by_instance_count.slice(1, 9) %}
            <li>
                <a class="jh-party-name" href="{{ basePath }}{{ picker.resource_url }}">{{ name }}</a>
                <span class="jh-party-plays">{{ picker.instruments_display }}</span>
                <span class="jh-party-count">{{ picker.total_instance_count }} instance{% if picker.total_instance_count != 1 %}s{% endif %}</span>
            </li>
            {% endfor %}
        </ul>
        <div class="px-btns">
            <a class="px-btn" href="{{ basePath }}/ensemble">Meet the musicians</a>
        </div>
    </section>

    {# ---- Watch: two sessions, loaded when pressed ---- #}
    {% if media.sessions and media.sessions.length %}
    <section class="px-box" aria-labelledby="watch">
        <h2 class="px-title" id="watch">Watch</h2>
        <ul class="jh-tapes">
            {% for tape in media.sessions.slice(0, 2) %}
                {% include 'partials/tape.njk' %}
            {% endfor %}
            {% for tape in media.live.slice(0, 1) %}
                {% include 'partials/tape.njk' %}
            {% endfor %}
        </ul>
        <div class="px-btns">
            <a class="px-btn" href="{{ basePath }}/listen#sessions">More sessions, shows and talks</a>
        </div>
    </section>
    {% endif %}

</div>
{% endblock %}
