{% extends '../../../base.njk' %}
{% block main %}

<div class="row">
    <div class="col-1"></div>
    <div class="col-md-10 text-post">
        <h1 class="text-center pixel-font">Pending Blue Railroad Submissions</h1>
        <p class="text-center text-muted">Submissions awaiting minting from PickiPedia</p>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card semi-transparent-bg mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Pending Submissions</h5>
                            <span class="badge bg-secondary">Updated at build time</span>
                        </div>

                        {% if pendingSubmissions and pendingSubmissions.length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Exercise</th>
                                        <th>Participants</th>
                                        <th>Block Height</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for submission in pendingSubmissions %}
                                    <tr>
                                        <td>
                                            <a href="{{ submission.url }}" target="_blank">{{ submission.id }}</a>
                                        </td>
                                        <td>{{ submission.exercise }}</td>
                                        <td>
                                            {% for participant in submission.participants %}
                                            <span class="badge bg-secondary me-1" title="{{ participant.wallet }}">
                                                {{ participant.name }}
                                            </span>
                                            {% endfor %}
                                        </td>
                                        <td>
                                            {% if submission.blockHeight %}
                                            <a href="https://etherscan.io/block/{{ submission.blockHeight }}" target="_blank" class="font-monospace">
                                                {{ submission.blockHeight }}
                                            </a>
                                            {% else %}
                                            <span class="text-muted">—</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="/blox-office/admin/mint-tony{% if submission.songId %}?song={{ submission.songId }}{% endif %}"
                                               class="btn btn-primary btn-sm">
                                                Mint
                                            </a>
                                            <a href="{{ submission.url }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                                                View
                                            </a>
                                            {% if submission.videoUrl %}
                                            <a href="{{ submission.videoUrl }}" target="_blank" class="btn btn-outline-info btn-sm">
                                                Video
                                            </a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="alert alert-success mb-0">
                            No pending submissions — all caught up!
                        </div>
                        {% endif %}
                    </div>
                </div>

                {% if pendingSubmissions and pendingSubmissions.length > 0 %}
                <div class="card semi-transparent-bg mb-4">
                    <div class="card-body">
                        <h6 class="card-title">Submission Details</h6>
                        <div class="accordion" id="submissionDetails">
                            {% for submission in pendingSubmissions %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading{{ submission.id }}">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapse{{ submission.id }}">
                                        Submission #{{ submission.id }}: {{ submission.exercise }}
                                    </button>
                                </h2>
                                <div id="collapse{{ submission.id }}" class="accordion-collapse collapse"
                                     data-bs-parent="#submissionDetails">
                                    <div class="accordion-body">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-3">Exercise</dt>
                                            <dd class="col-sm-9">{{ submission.exercise }}</dd>

                                            <dt class="col-sm-3">Song ID</dt>
                                            <dd class="col-sm-9">{{ submission.songId or '—' }}</dd>

                                            <dt class="col-sm-3">Block Height</dt>
                                            <dd class="col-sm-9">
                                                {% if submission.blockHeight %}
                                                <a href="https://etherscan.io/block/{{ submission.blockHeight }}" target="_blank">
                                                    {{ submission.blockHeight }}
                                                </a>
                                                {% else %}—{% endif %}
                                            </dd>

                                            <dt class="col-sm-3">Participants</dt>
                                            <dd class="col-sm-9">
                                                <ul class="list-unstyled mb-0">
                                                    {% for participant in submission.participants %}
                                                    <li>
                                                        <strong>{{ participant.name }}</strong>:
                                                        <code>{{ participant.wallet }}</code>
                                                    </li>
                                                    {% endfor %}
                                                </ul>
                                            </dd>

                                            {% if submission.video %}
                                            <dt class="col-sm-3">Video</dt>
                                            <dd class="col-sm-9">
                                                <a href="{{ submission.videoUrl }}" target="_blank">{{ submission.video }}</a>
                                            </dd>
                                            {% endif %}

                                            <dt class="col-sm-3">PickiPedia</dt>
                                            <dd class="col-sm-9">
                                                <a href="{{ submission.url }}" target="_blank">{{ submission.url }}</a>
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="card semi-transparent-bg">
                    <div class="card-body">
                        <h6 class="card-title">Quick Links</h6>
                        <ul class="mb-0">
                            <li><a href="/blox-office/admin/mint-tony">Mint Token Page</a></li>
                            <li><a href="https://pickipedia.xyz/wiki/Category:Blue_Railroad_Submissions" target="_blank">All Submissions on PickiPedia</a></li>
                            <li><a href="https://pickipedia.xyz/wiki/Blue_Railroad/Pending_Submissions" target="_blank">PickiPedia Pending Queue (SMW)</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-1"></div>
</div>

<style>
.pixel-font {
    font-family: 'Courier New', monospace;
    font-weight: bold;
}
</style>

{% endblock %}
